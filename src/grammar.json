{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "fey",
  "rules": {
    "document": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "preamble",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "REPEAT",
                "content": {
                  "type": "SYMBOL",
                  "name": "_newline"
                }
              },
              {
                "type": "REPEAT",
                "content": {
                  "type": "SYMBOL",
                  "name": "content"
                }
              }
            ]
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "subsection"
          }
        }
      ]
    },
    "content": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "paragraph"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_newline"
          }
        }
      ]
    },
    "subsection": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_section_start"
        },
        {
          "type": "SYMBOL",
          "name": "heading"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "body"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "subsection"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_section_end"
        }
      ]
    },
    "heading": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "  "
        },
        {
          "type": "FIELD",
          "name": "prefix",
          "content": {
            "type": "SYMBOL",
            "name": "heading_prefix"
          }
        },
        {
          "type": "FIELD",
          "name": "title",
          "content": {
            "type": "SYMBOL",
            "name": "title"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_newline"
          }
        }
      ]
    },
    "body": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "content"
      }
    },
    "heading_prefix": {
      "type": "REPEAT1",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "PATTERN",
            "value": "[a-zA-Z0-9_<>{}()\\[\\]]*"
          },
          {
            "type": "PATTERN",
            "value": "[.,:;/\\\\!?'\"\\-+*=@&#$%]"
          }
        ]
      }
    },
    "title": {
      "type": "SEQ",
      "members": [
        {
          "type": "PATTERN",
          "value": "[ \\t]+"
        },
        {
          "type": "PATTERN",
          "value": "[^\\r\\n]*"
        }
      ]
    },
    "paragraph": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "REPEAT1",
        "content": {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_line_content"
            },
            {
              "type": "SYMBOL",
              "name": "_newline"
            }
          ]
        }
      }
    },
    "_newline": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "_line_content"
    },
    {
      "type": "SYMBOL",
      "name": "_section_start"
    },
    {
      "type": "SYMBOL",
      "name": "_section_end"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}